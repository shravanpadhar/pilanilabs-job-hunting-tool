# ─────────────────────────────────────────────────────────────────────────────
# Pilanilabs Job Hunting Tool — environment variables
# Copy to `.env.local` and fill in. Nothing here is sent to the browser unless it
# starts with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL (used in email links and auth redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local-only shortcut: skip Supabase auth and sign in as a fixed dev user.
# Ignored when NODE_ENV=production. Resume files are then stored in ./.local-storage.
DEV_AUTH_BYPASS=false

# Secret that protects /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <secret>").
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Database (PostgreSQL via Supabase) ───────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string.
# DATABASE_URL: pooled connection (port 6543, "Transaction pooler") used by the app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pilanilabs
# DIRECT_URL: direct connection (port 5432) used by `prisma migrate`. Optional locally.
DIRECT_URL=

# ── Supabase (Auth + Storage) ────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Used for private storage (resume files).
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for resumes / exports. Created automatically on first upload.
SUPABASE_STORAGE_BUCKET=resumes

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional model overrides (defaults live in config/ai.ts)
# ANTHROPIC_MODEL_QUALITY=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# ── Free AI via OpenRouter (alternative to Anthropic) ──────────────────────────
# Set AI_PROVIDER=openrouter and add a key from https://openrouter.ai/keys to use FREE models instead of Claude.
# Free models are rate-limited and less accurate than Claude; the no-invented-facts guard still runs in code.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# Defaults (comma-separated = fallback chain; see https://openrouter.ai/models?max_price=0):
#   quality: nvidia/nemotron-3-ultra-550b-a55b:free, nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free
#   fast:    nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL_QUALITY=
# OPENROUTER_MODEL_FAST=
# AI scoring of the job feed is ON by default. It uses many requests, so on free models with small daily quotas you can disable it:
# AI_MATCH_SCORING=false

# ── Job sources (each connector is skipped when its key is missing) ─────────
# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# Adzuna — https://developer.adzuna.com/ (free app id + key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Remotive, RemoteOK, Arbeitnow, Jobicy, Greenhouse, Lever and Ashby need no key.
# Contact string sent in the User-Agent of public API calls (be a good citizen).
JOB_SOURCES_CONTACT=https://www.pilanilabs.com

# ── Alerts (optional) ────────────────────────────────────────────────────────
# Email — https://resend.com/api-keys  (RESEND_FROM must be a verified sender)
RESEND_API_KEY=
RESEND_FROM="Pilanilabs Jobs <jobs@your-verified-domain.com>"
# WhatsApp — Twilio WhatsApp API: https://console.twilio.com → Messaging → WhatsApp
# TWILIO_WHATSAPP_FROM looks like "whatsapp:+14155238886" (sandbox) or your approved sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional approved WhatsApp template (Content SID) for business-initiated digests.
TWILIO_WHATSAPP_CONTENT_SID=

# ═════════════════════════════════════════════════════════════════════════════
# Outreach engine (Pilanilabs Career Platform)
# Every service below has a FAKE that is used automatically when its key is blank, so the app and all
# tests run with zero keys. Leave values blank (not "YOUR_KEY_HERE") unless you have the real secret:
# a non-blank value switches that service from the fake to the real provider.
# In production the startup check (instrumentation.ts) refuses to boot with missing core secrets, and
# with OUTREACH_SENDING_ENABLED=true it also requires every real provider below.
# ═════════════════════════════════════════════════════════════════════════════

# ── Safety switches ──────────────────────────────────────────────────────────
# Global kill switch for sending. Defaults to true outside production and false in production.
# Set to true in production only when every provider below is configured and you are ready to go live.
OUTREACH_SENDING_ENABLED=
# Local/test only: enables fixture HTTP responses, a fake clock and injected replies. Refused in production.
EXTERNAL_FAKES=false
# Comma-separated emails allowed into /admin. Every admin action is audit-logged.
ADMIN_EMAILS=

# ── Secrets generated by you (never reuse across environments) ───────────────
# 32 random bytes, hex or base64:   openssl rand -hex 32
# Wraps the per-token keys that encrypt stored mailbox refresh tokens.
TOKEN_ENCRYPTION_KEY=
# Only during key rotation: the PREVIOUS value of TOKEN_ENCRYPTION_KEY, so old tokens still decrypt.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# HMAC key for the hashed do-not-contact list. If you lose or change it, existing entries stop matching: back it up.
SUPPRESSION_HASH_KEY=
# HMAC key that signs the opt-out link in every outgoing email.
OPT_OUT_SIGNING_KEY=

# ── Queue (durable background jobs; Vercel cannot run long-lived workers) ───
# inngest (production) | inline (local, in-process fake). Blank = inngest when INNGEST_EVENT_KEY is set, else inline.
QUEUE_PROVIDER=
# https://app.inngest.com -> your app -> Event keys / Signing key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Mailbox: the candidate's own Gmail via OAuth ─────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web). Scopes used: openid, email,
# gmail.send, gmail.readonly (restricted: needs Google verification, see README).
# Redirect URI to register: <NEXT_PUBLIC_APP_URL>/api/connect/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# gmail | fake. Blank = gmail when both Google values are set, else fake.
MAILBOX_PROVIDER=
# Outlook via Microsoft Graph (v2, not built yet). Microsoft Entra -> App registrations.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Licensed contact data and email verification (no scraping, ever) ─────────
# The provider chosen in the bake-off. Until then the fake provider generates deterministic sample contacts.
CONTACT_DATA_API_KEY=
CONTACT_DATA_PROVIDER=
EMAIL_VERIFY_API_KEY=
EMAIL_VERIFY_PROVIDER=

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=

# The spec lists QUEUE_URL / QUEUE_TOKEN for a generic managed queue. This build uses Inngest, so the equivalents are
# INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY above (docs/DECISIONS.md D-06). Unused, kept only so the spec names are searchable:
# QUEUE_URL=
# QUEUE_TOKEN=
