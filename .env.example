# ─────────────────────────────────────────────────────────────────────────────
# Pilanilabs Job Hunting Tool — environment variables
# Copy to `.env.local` and fill in. Nothing here is sent to the browser unless it
# starts with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL (used in email links and auth redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local-only shortcut: skip Supabase auth and sign in as a fixed dev user.
# Ignored when NODE_ENV=production. Resume files are then stored in ./.local-storage.
DEV_AUTH_BYPASS=false

# Secret that protects /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <secret>").
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Database (PostgreSQL via Supabase) ───────────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string.
# DATABASE_URL: pooled connection (port 6543, "Transaction pooler") used by the app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pilanilabs
# DIRECT_URL: direct connection (port 5432) used by `prisma migrate`. Optional locally.
DIRECT_URL=

# ── Supabase (Auth + Storage) ────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Used for private storage (resume files).
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for resumes / exports. Created automatically on first upload.
SUPABASE_STORAGE_BUCKET=resumes

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional model overrides (defaults live in config/ai.ts)
# ANTHROPIC_MODEL_QUALITY=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# ── Job sources (each connector is skipped when its key is missing) ─────────
# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# Adzuna — https://developer.adzuna.com/ (free app id + key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Remotive, RemoteOK, Arbeitnow, Jobicy, Greenhouse, Lever and Ashby need no key.
# Contact string sent in the User-Agent of public API calls (be a good citizen).
JOB_SOURCES_CONTACT=https://www.pilanilabs.com

# ── Alerts (optional) ────────────────────────────────────────────────────────
# Email — https://resend.com/api-keys  (RESEND_FROM must be a verified sender)
RESEND_API_KEY=
RESEND_FROM="Pilanilabs Jobs <jobs@your-verified-domain.com>"
# WhatsApp — Twilio WhatsApp API: https://console.twilio.com → Messaging → WhatsApp
# TWILIO_WHATSAPP_FROM looks like "whatsapp:+14155238886" (sandbox) or your approved sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional approved WhatsApp template (Content SID) for business-initiated digests.
TWILIO_WHATSAPP_CONTENT_SID=
