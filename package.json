{
  "name": "pilanilabs-job-hunting-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Pilanilabs Job Hunting Tool — resume-matched job feed, tailored resumes, ATS checks and application tracking.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "fetch-jobs": "tsx scripts/fetch-jobs.ts",
    "send-alerts": "tsx scripts/send-alerts.ts",
    "db:local": "tsx scripts/local-db.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "eval:fabrication": "tsx evals/run-fabrication.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.11.0",
    "html-to-text": "^9.0.5",
    "inngest": "^4.26.1",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.33.0",
    "sanitize-html": "^2.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
