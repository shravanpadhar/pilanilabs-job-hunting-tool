// Pilanilabs Job Hunting Tool — data model.
// User ids are Supabase auth user ids (uuid). Row Level Security is enabled in
// migration 0002_rls (it only takes effect on Supabase, where the `auth` schema exists).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

enum AlertFrequency {
  OFF
  DAILY
  WEEKLY
}

enum AtsProvider {
  GREENHOUSE
  LEVER
  ASHBY
}

enum ExperienceFit {
  UNDER
  FIT
  OVER
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  resumes         Resume[]
  preferences     Preferences?
  matches         Match[]
  tailoredResumes TailoredResume[]
  applications    Application[]
  savedSearches   SavedSearch[]
  aiUsage         AiUsage[]
  referralDrafts  ReferralDraft[]
  alertLogs       AlertLog[]
  companyReviews  CompanyReview[]
  companyBoards   CompanyBoard[]

  // Outreach engine
  ownedJobs         Job[]              @relation("JobOwner")
  outreachProfile   OutreachProfile?
  connectedAccounts ConnectedAccount[]
  campaigns         OutreachCampaign[]
  creditLedger      CreditLedger[]
  providerUsage     ProviderUsage[]
}

model Resume {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  fileName   String
  fileUrl    String? // private storage path (never a public URL)
  rawText    String   @db.Text
  parsedJson Json
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoredResumes TailoredResume[]

  @@index([userId])
}

model Preferences {
  userId           String     @id @db.Uuid
  targetRoles      String[]
  locations        String[]
  workModes        WorkMode[]
  minSalary        Int?
  currency         String     @default("INR")
  experienceLevel  String?
  jobTypes         JobType[]
  keywordsInclude  String[]
  keywordsExclude  String[]
  noticePeriodDays Int?

  // Alerts (top new matches digest)
  alertFrequency AlertFrequency @default(OFF)
  alertEmail     Boolean        @default(true)
  alertWhatsapp  Boolean        @default(false)
  whatsappNumber String?
  alertMinScore  Int            @default(70)
  lastAlertAt    DateTime?

  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id              String   @id @default(cuid())
  source          String
  externalId      String
  title           String
  company         String
  companySlug     String
  companyLogoUrl  String?
  location        String?
  country         String?
  isRemote        Boolean  @default(false)
  employmentType  JobType?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  descriptionHtml String?  @db.Text
  descriptionText String   @db.Text
  postedAt        DateTime
  applyUrl        String
  publisher       String? // e.g. "LinkedIn" when an aggregator reports it
  attributionUrl  String? // link back required by some sources (Remotive, RemoteOK, Jobicy)
  fetchedAt       DateTime @default(now())
  dedupeHash      String   @unique
  // Every source that has listed this job. A job is "hidden" when it is only
  // present on direct company boards (Greenhouse / Lever / Ashby).
  sourcesSeen     String[]
  // Canonical skills detected in title + description (computed at ingest; used by matching).
  skills          String[]
  isDirect        Boolean  @default(false)
  isSeed          Boolean  @default(false)
  // null = shared job (feed). Set = a job the user pasted for outreach; private to that user (never in the feed).
  ownerUserId     String?  @db.Uuid

  owner        User?              @relation("JobOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  campaigns    OutreachCampaign[]
  matches      Match[]
  tailored     TailoredResume[]
  applications Application[]
  referrals    ReferralDraft[]

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([companySlug])
  @@index([isDirect, postedAt])
  @@index([ownerUserId])
}

model Match {
  id             String         @id @default(cuid())
  userId         String         @db.Uuid
  jobId          String
  score          Int
  stage1Score    Int
  aiScored       Boolean        @default(false)
  // Hash of the candidate profile this score was computed for; AI scores are reused while it is unchanged.
  profileHash    String         @default("")
  reason         String         @default("")
  matchingSkills String[]
  missingSkills  String[]
  experienceFit  ExperienceFit?
  notifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, score])
}

model TailoredResume {
  id              String   @id @default(cuid())
  userId          String   @db.Uuid
  jobId           String
  baseResumeId    String
  contentJson     Json
  changes         Json?
  skillGaps       Json?
  pdfUrl          String?
  docxUrl         String?
  coverLetterText String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  baseResume   Resume             @relation(fields: [baseResumeId], references: [id], onDelete: Cascade)
  applications Application[]
  campaigns    OutreachCampaign[]

  @@unique([userId, jobId, baseResumeId])
  @@index([userId])
}

model Application {
  id               String            @id @default(cuid())
  userId           String            @db.Uuid
  jobId            String
  tailoredResumeId String?
  status           ApplicationStatus @default(SAVED)
  position         Int               @default(0)
  appliedAt        DateTime?
  notes            String?           @db.Text
  followUpDate     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tailoredResume TailoredResume? @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)

  @@unique([userId, jobId])
  @@index([userId, status])
}

model SavedSearch {
  id             String         @id @default(cuid())
  userId         String         @db.Uuid
  name           String
  filters        Json
  alertFrequency AlertFrequency @default(OFF)
  alertEmail     Boolean        @default(true)
  alertWhatsapp  Boolean        @default(false)
  lastAlertAt    DateTime?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CompanyProfile {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  website        String?
  logoUrl        String?
  description    String?   @db.Text
  industry       String?
  hqLocation     String?
  foundedYear    Int?
  sizeRange      String?
  fundingStage   String?
  fundingNote    String?
  investors      String[]
  glassdoorUrl   String?
  ambitionboxUrl String?
  linkedinUrl    String?
  careersUrl     String?
  dataSource     String?
  dataAsOf       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviews   CompanyReview[]
  campaigns OutreachCampaign[]
}

model CompanyReview {
  id           String   @id @default(cuid())
  companyId    String
  userId       String   @db.Uuid
  rating       Int
  title        String
  pros         String   @db.Text
  cons         String   @db.Text
  roleTitle    String?
  relationship String // CURRENT | FORMER | INTERVIEWED
  createdAt    DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

model CompanyBoard {
  id            String      @id @default(cuid())
  provider      AtsProvider
  slug          String
  companyName   String
  addedByUserId String?     @db.Uuid
  enabled       Boolean     @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  jobCount      Int         @default(0)
  createdAt     DateTime    @default(now())

  addedBy User? @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([provider, slug])
}

model AiUsage {
  id              String   @id @default(cuid())
  userId          String?  @db.Uuid
  feature         String
  model           String
  inputTokens     Int
  outputTokens    Int
  cacheReadTokens Int      @default(0)
  // Estimated cost in millionths of a US dollar (config/ai-pricing.ts); null for rows logged before cost tracking.
  costMicros      Int?
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
}

model ReferralDraft {
  id              String   @id @default(cuid())
  userId          String   @db.Uuid
  jobId           String
  contactName     String?
  contactRole     String?
  relationship    String
  connectionNote  String
  followUpMessage String   @db.Text
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, jobId])
}

model AlertLog {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  channel   String
  status    String
  jobCount  Int      @default(0)
  detail    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FetchRun {
  id         String    @id @default(cuid())
  source     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  fetched    Int       @default(0)
  inserted   Int       @default(0)
  updated    Int       @default(0)
  error      String?
}

// ─────────────────────────────────────────────────────────────────────────────
// Outreach engine (spec section 13, plus the additions logged in docs/DECISIONS.md D-07/D-08)
// RLS for these tables lives in migration 0004_outreach_rls: owner read-only, writes only via the server.
// ─────────────────────────────────────────────────────────────────────────────

enum ConnectedProvider {
  GMAIL
  OUTLOOK
}

enum ConnectedStatus {
  ACTIVE
  REVOKED
  ERROR
}

enum CampaignMode {
  REVIEW_ALL
  APPROVE_FIRST
  AUTO
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TargetRole {
  HIRING_MANAGER
  TEAM_LEAD
  RECRUITER
  WARM_PATH
}

enum EmailVerification {
  VALID
  RISKY
  INVALID
  UNKNOWN
}

enum TargetState {
  DISCOVERED
  VERIFIED
  DRAFTED
  APPROVED
  SCHEDULED
  SENT
  REPLIED
  BOUNCED
  OPTED_OUT
  COMPLETED
  CANCELLED
}

enum MessageChannel {
  EMAIL
  LINKEDIN_NOTE
  LINKEDIN_MESSAGE
}

enum MessageState {
  DRAFT
  APPROVED
  SCHEDULED
  SENDING // claimed by one worker, provider call in flight (D-07)
  SENT
  FAILED
  CANCELLED
}

enum LinkedInState {
  NOT_STARTED
  CONNECT_PENDING
  ACCEPTED
  MESSAGED
  WITHDRAWN
}

enum MarkedBy {
  USER
  SYSTEM
}

enum ReplyClass {
  INTERESTED
  REFERRAL
  NOT_NOW
  NO
  OUT_OF_OFFICE
  UNSUBSCRIBE
  OTHER
}

enum SuppressionReason {
  OPT_OUT
  BOUNCE
  COMPLAINT
  MANUAL
}

enum CreditReason {
  PURCHASE
  SPEND_TARGET
  SPEND_VERIFY
  REFUND
  REPLY_BONUS
  TRIAL_GRANT
  ADJUSTMENT
}

/// The candidate's own mailbox. The refresh token is envelope-encrypted; never select it casually.
model ConnectedAccount {
  id                    String            @id @default(cuid())
  userId                String            @db.Uuid
  provider              ConnectedProvider
  accountEmail          String
  encryptedRefreshToken String            @db.Text
  scopes                String[]
  status                ConnectedStatus   @default(ACTIVE)
  dailySendCap          Int               @default(20)
  warmupStage           Int               @default(0)
  // Provider-specific incremental sync position (Gmail historyId) for the reply poller.
  syncCursor            String?
  lastSyncAt            DateTime?
  lastError             String?
  connectedAt           DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountEmail])
  @@index([status])
}

/// Sender identity and sending policy per candidate (one row per user).
model OutreachProfile {
  userId            String    @id @db.Uuid
  senderName        String?
  postalAddress     String?   @db.Text // CAN-SPAM physical address of record (D-21)
  timeZone          String    @default("Asia/Kolkata") // IANA, the candidate's own
  notifyEmail       Boolean   @default(true)
  notifyWhatsapp    Boolean   @default(false)
  whatsappNumber    String?
  sendingPausedAt   DateTime?
  pauseReason       String?
  pausedBy          MarkedBy?
  costCeilingMicros Int? // per-candidate override of the cost ceiling
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutreachCampaign {
  id               String         @id @default(cuid())
  userId           String         @db.Uuid
  jobId            String? // null for external links before a private Job row exists
  sourceUrl        String?
  jobSnapshot      Json
  tailoredResumeId String?
  companyId        String?
  companyKey       String // slug of the employer; drives the one-touch-per-company-per-30-days rule
  companyType      String? // bucket used by insights (startup | scaleup | enterprise | unknown)
  mode             CampaignMode   @default(REVIEW_ALL)
  status           CampaignStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  finishedAt       DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  tailoredResume TailoredResume?  @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)
  company        CompanyProfile?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  targets        OutreachTarget[]

  @@index([userId, status])
  @@index([userId, companyKey, createdAt])
}

model OutreachTarget {
  id                 String            @id @default(cuid())
  campaignId         String
  fullName           String
  title              String?
  roleType           TargetRole
  companyDomain      String?
  email              String?
  emailHash          String? // HMAC of the normalised address, for suppression checks (D-09)
  emailVerification  EmailVerification @default(UNKNOWN)
  linkedinUrl        String?
  country            String? // ISO-3166 alpha-2, lowercase, when the provider knows it
  dataProvider       String
  sourceRef          String? // provider's record id / evidence for a warm path
  confidence         Float             @default(0)
  // Set when the candidate explicitly accepted a below-threshold / risky / unknown-country contact.
  riskAcknowledgedAt DateTime?
  state              TargetState       @default(DISCOVERED)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  campaign OutreachCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages OutreachMessage[]
  linkedin LinkedInStep?

  @@index([campaignId, state])
  @@index([emailHash])
}

model OutreachMessage {
  id                String         @id @default(cuid())
  targetId          String
  channel           MessageChannel
  step              Int // 1, 2, 3
  subject           String?
  body              String         @db.Text
  templateKey       String? // e.g. "email.v1.cold" - insights group by this
  approvedAt        DateTime?
  approvedTextHash  String?
  // sha256(messageId | approvedTextHash); unique so one approved text can never be sent twice (D-07).
  sendKey           String?        @unique
  attachmentSha256  String?
  scheduledAt       DateTime?
  claimedAt         DateTime?
  attempts          Int            @default(0)
  lastError         String?
  sentAt            DateTime?
  providerMessageId String?
  threadId          String?
  state             MessageState   @default(DRAFT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  target  OutreachTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  replies Reply[]

  @@unique([targetId, channel, step])
  @@index([scheduledAt, state])
}

model LinkedInStep {
  id          String        @id @default(cuid())
  targetId    String        @unique
  state       LinkedInState @default(NOT_STARTED)
  requestedAt DateTime?
  acceptedAt  DateTime?
  markedBy    MarkedBy      @default(USER)
  expiresAt   DateTime?
  updatedAt   DateTime      @updatedAt

  target OutreachTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model Reply {
  id                String     @id @default(cuid())
  messageId         String
  providerMessageId String     @unique // makes polling idempotent
  receivedAt        DateTime
  snippet           String // up to 300 chars; full bodies are not stored (D-15)
  classification    ReplyClass @default(OTHER)
  ruleHit           String? // which deterministic rule decided it (bounce, unsubscribe, hostile, auto-reply)
  suggestedResponse String?    @db.Text
  createdAt         DateTime   @default(now())

  message OutreachMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// Global do-not-contact list. Deliberately NO relation to User: it survives account deletion.
model SuppressionEntry {
  id        String            @id @default(cuid())
  emailHash String            @unique
  reason    SuppressionReason
  createdAt DateTime          @default(now())
}

/// Who did what, when. Deliberately NO relation to User (survives deletion); `detail` never holds plaintext emails.
model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model CreditLedger {
  id        String       @id @default(cuid())
  userId    String       @db.Uuid
  delta     Int
  reason    CreditReason
  refType   String
  refId     String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Makes every spend / refund / grant idempotent: the same event can never post twice.
  @@unique([userId, reason, refType, refId])
  @@index([userId, createdAt])
}

model ProviderUsage {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  provider   String
  operation  String
  costMicros Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, createdAt])
}

/// Admin-editable settings (pricing, caps, thresholds) layered over config defaults.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
